{
  "name": "magpie-ech-middleware",
  "version": "0.7.0",
  "description": "DoH for magpie with optional ECH discovered from each upstream's own HTTPS DNS record",
  "type": "module",
  "main": "./ech.plugin.js",
  "files": [
    "ech.plugin.js",
    "ech.providers.js",
    "ech.shared.js",
    "ech.hooks.js",
    "sidecar.mjs",
    "sidecar/main.go",
    "sidecar/doh.go",
    "sidecar/dns.go",
    "sidecar/ech.go",
    "sidecar/go.mod",
    "scripts/build.mjs",
    "scripts/build-all.mjs",
    "scripts/go.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "doh",
    "dns-over-https",
    "dns",
    "tls",
    "privacy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/li-notfish/magpie-ech-middleware"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build-all.mjs",
    "test": "bun test"
  },
  "magpie": {
    "hooks": "./ech.hooks.js",
    "options": {
      "port": 8790,
      "doh": "",
      "ech": false
    }
  }
}
